<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- iOS-style app theme (design-system/). Colors come from colors.xml, which values-night overrides. -->
    <style name="Base.Theme.TTS" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/tint</item>
        <item name="colorPrimaryVariant">@color/tint</item>
        <item name="colorOnPrimary">@color/on_tint</item>
        <item name="colorSecondary">@color/tint</item>
        <item name="colorSecondaryVariant">@color/tint</item>
        <item name="colorOnSecondary">@color/on_tint</item>
        <item name="colorSurface">@color/secondary_grouped_bg</item>
        <item name="colorOnSurface">@color/label</item>
        <item name="colorError">@color/red</item>
        <item name="colorControlActivated">@color/tint</item>
        <item name="colorAccent">@color/tint</item>
        <item name="android:colorBackground">@color/grouped_bg</item>
        <item name="android:windowBackground">@color/grouped_bg</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/secondary_label</item>

        <item name="android:statusBarColor">@color/grouped_bg</item>
        <item name="android:navigationBarColor">@color/grouped_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="actionBarStyle">@style/Widget.TTS.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.TTS.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TTS.Alert</item>
    </style>

    <!-- Screens that keep a top bar (NeckActivity, NeckCollectActivity): flat, same color as the page. -->
    <style name="Theme.TTS" parent="Base.Theme.TTS" />

    <!-- Home: large title drawn in the layout instead of a bar. -->
    <style name="Theme.TTS.NoActionBar" parent="Base.Theme.TTS">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.TTS.ActionBar" parent="Widget.MaterialComponents.Light.ActionBar.Solid">
        <item name="background">@color/grouped_bg</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.TTS.BarTitle</item>
    </style>

    <style name="TextAppearance.TTS.BarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- iOS filled button: 12 radius, flat, sentence case, 17sp semibold. The 6dp insets keep stacked
         buttons apart in layouts that set no margins between them; the visible height stays 50. -->
    <style name="Widget.TTS.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/tint</item>
        <item name="android:textColor">@color/on_tint</item>
    </style>

    <!-- iOS plain (text) button: tint text, no background. -->
    <style name="Widget.TTS.Button.Plain" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tint_ink</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ThemeOverlay.TTS.Alert" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_alert</item>
        <item name="colorPrimary">@color/tint_ink</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TTS.AlertButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TTS.AlertButton</item>
    </style>

    <style name="Widget.TTS.AlertButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/tint_ink</item>
    </style>

    <!-- Text styles (HIG names) -->
    <style name="Text.TTS.LargeTitle" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
    </style>
    <style name="Text.TTS.Title1" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Text.TTS.Body" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/label</item>
    </style>
    <style name="Text.TTS.Subheadline" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/secondary_label</item>
    </style>
    <style name="Text.TTS.Footnote" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/secondary_label</item>
    </style>
    <style name="Text.TTS.SectionHeader" parent="Text.TTS.Footnote">
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>
    <style name="Text.TTS.SectionFooter" parent="Text.TTS.Footnote">
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">7dp</item>
    </style>
    <style name="Text.TTS.Value" parent="Text.TTS.Body">
        <item name="android:textColor">@color/secondary_label</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Inset-grouped list -->
    <style name="Widget.TTS.InsetGroup" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/secondary_grouped_bg</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>
    <style name="Widget.TTS.Row" parent="">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Widget.TTS.Row.Tappable">
        <item name="android:background">@drawable/bg_row_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.TTS.Separator" parent="">
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/separator</item>
    </style>
    <style name="Widget.TTS.IconTile" parent="">
        <item name="android:layout_width">29dp</item>
        <item name="android:layout_height">29dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="tint">@color/on_tint</item>
    </style>
</resources>

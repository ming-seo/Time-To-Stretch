<?xml version="1.0" encoding="utf-8"?>
<!-- Home, per design-system/concept.html "First view": large title, one focal card, inset-grouped lists. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grouped_bg"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/Text.TTS.LargeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/main_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLanguage"
                style="@style/Widget.TTS.Button.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/language_toggle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Text.TTS.Subheadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_off" />
        </LinearLayout>

        <!-- Focal card: progress toward the stretch reminder -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TTS.InsetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.TTS.Footnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_until_reminder" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotal"
                        style="@style/Text.TTS.Title1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0" />

                    <TextView
                        android:id="@+id/tvThreshold"
                        style="@style/Text.TTS.Subheadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="/ 30" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    app:indicatorColor="@color/tint"
                    app:trackColor="@color/track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tvTotalCaption"
                    style="@style/Text.TTS.Footnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/main_total_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: monitoring -->
        <TextView
            style="@style/Text.TTS.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_section_tracking" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TTS.InsetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/rowMonitoring"
                style="@style/Widget.TTS.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/Widget.TTS.IconTile"
                    android:backgroundTint="@color/green_dot"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_activity" />

                <TextView
                    style="@style/Text.TTS.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/switchMonitoring"
                    android:text="@string/main_background_tracking" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMonitoring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/main_background_tracking"
                    android:minHeight="44dp"
                    android:saveEnabled="false"
                    android:thumb="@drawable/switch_thumb"
                    app:switchMinWidth="51dp"
                    app:track="@drawable/switch_track" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.TTS.SectionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_tracking_footer" />

        <!-- Section: current load -->
        <TextView
            style="@style/Text.TTS.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_section_debt" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TTS.InsetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.TTS.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Widget.TTS.IconTile"
                        android:backgroundTint="@color/tint"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_smartphone" />

                    <TextView
                        style="@style/Text.TTS.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/neck_tilt" />

                    <TextView
                        android:id="@+id/tvNeckDebt"
                        style="@style/Text.TTS.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0" />
                </LinearLayout>

                <View
                    style="@style/Widget.TTS.Separator"
                    android:layout_width="match_parent"
                    android:layout_marginStart="57dp" />

                <LinearLayout
                    style="@style/Widget.TTS.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Widget.TTS.IconTile"
                        android:backgroundTint="@color/orange"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_armchair" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.TTS.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sitting_time" />

                        <TextView
                            android:id="@+id/tvSitState"
                            style="@style/Text.TTS.Footnote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tracking_off" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSitDebt"
                        style="@style/Text.TTS.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvLastEval"
            style="@style/Text.TTS.SectionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_calculated" />

        <!-- Tools -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TTS.InsetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowOpenNeck"
                    style="@style/Widget.TTS.Row.Tappable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Text.TTS.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_neck_debug" />

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    style="@style/Widget.TTS.Separator"
                    android:layout_width="match_parent"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/rowResetDebts"
                    style="@style/Widget.TTS.Row.Tappable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_d"
                    android:textColor="@color/red"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Transition log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/Text.TTS.Footnote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingBottom="7dp"
                android:text="@string/main_activity_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                style="@style/Widget.TTS.Button.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TTS.InsetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLog"
                style="@style/Text.TTS.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:text="@string/no_records" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
